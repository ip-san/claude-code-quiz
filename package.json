{
  "name": "claude-code-quiz",
  "version": "1.0.0",
  "description": "Production-ready Electron quiz app for Claude Code learning",
  "author": "Claude Code Quiz Contributors",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.config.web.ts",
    "build": "tsc && vite build && electron-builder",
    "build:web": "tsc && vite build --config vite.config.web.ts",
    "preview": "vite preview",
    "preview:web": "vite preview --config vite.config.web.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src/ mcp/ scripts/",
    "format:check": "biome format src/ mcp/ scripts/",
    "lint": "biome lint src/ mcp/ scripts/",
    "knip": "knip",
    "circular": "npx madge --circular --extensions ts,tsx src/",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:arch": "node scripts/check-architecture.mjs",
    "cpd": "jscpd src --min-lines 5 --min-tokens 50 --ignore \"**/data/**\" --threshold 2",
    "type-coverage": "type-coverage --strict --at-least 99 --ignore-files '**/*.test.*'",
    "check:typecheck": "tsc --noEmit",
    "check:lint": "biome check src/ mcp/ scripts/",
    "check:parallel": "bun run check:typecheck & p1=$!; bun run check:lint & p2=$!; vitest run & p3=$!; wait $p1; s1=$?; wait $p2; s2=$?; wait $p3; s3=$?; exit $((s1 | s2 | s3))",
    "check": "bun run check:parallel && type-coverage --strict --at-least 99 --ignore-files '**/*.test.*' && node scripts/quiz-utils.mjs check",
    "check:all": "bun run check:parallel && type-coverage --strict --at-least 99 --ignore-files '**/*.test.*' && node scripts/quiz-utils.mjs check && node scripts/validate-docs.mjs && node scripts/validate-docs-links.mjs && bun run cpd",
    "docs:links": "node scripts/validate-docs-links.mjs",
    "docs:validate": "node scripts/validate-docs.mjs",
    "quiz:post-add": "node scripts/quiz-utils.mjs randomize && node scripts/quiz-utils.mjs check && node scripts/quiz-utils.mjs check-ellipsis && vitest run && node scripts/quiz-utils.mjs stats",
    "recommend": "node scripts/recommend.mjs",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "quiz:randomize": "node scripts/quiz-utils.mjs randomize",
    "quiz:stats": "node scripts/quiz-utils.mjs stats",
    "quiz:coverage": "node scripts/quiz-utils.mjs coverage",
    "quiz:check": "node scripts/quiz-utils.mjs check && node scripts/quiz-utils.mjs check-ellipsis",
    "quiz:search": "node scripts/quiz-utils.mjs search",
    "quiz:edit": "node scripts/quiz-utils.mjs edit",
    "quiz:merge-proposals": "node scripts/quiz-utils.mjs merge-proposals",
    "playtest:resolve": "node scripts/playtest-resolve.mjs",
    "playtest:apply": "node scripts/playtest-apply.mjs",
    "playtest:coverage": "node scripts/playtest-coverage.mjs",
    "skills:check": "node scripts/check-skills.mjs",
    "docs:fetch": "node scripts/fetch-docs.mjs",
    "docs:split": "node scripts/fetch-docs.mjs --split",
    "docs:assemble": "node scripts/fetch-docs.mjs --assemble",
    "docs:status": "node scripts/fetch-docs.mjs --status",
    "docs:check-updates": "node scripts/fetch-docs.mjs --check-updates",
    "docs:discover": "node scripts/fetch-docs.mjs --discover",
    "docs:changes": "node scripts/docs-changes.mjs",
    "verify:diff": "node scripts/verify-state.mjs diff",
    "verify:diff:full": "node scripts/verify-state.mjs diff --full",
    "verify:diff:force": "node scripts/verify-state.mjs diff --force",
    "verify:save": "node scripts/verify-state.mjs save",
    "verify:status": "node scripts/verify-state.mjs status",
    "verify:mapping": "node scripts/verify-state.mjs mapping",
    "verify:audit": "node scripts/audit-matched-quiz.mjs",
    "quiz:lint": "node scripts/quiz-lint.mjs all",
    "quiz:lint:dry": "node scripts/quiz-lint.mjs all --dry-run",
    "quiz:lint:backtick": "node scripts/quiz-lint.mjs backtick",
    "quiz:lint:url": "node scripts/quiz-lint.mjs url",
    "quiz:lint:terminology": "node scripts/quiz-lint.mjs terminology",
    "quiz:lint:distractor": "node scripts/quiz-lint.mjs distractor",
    "quiz:lint:difficulty": "node scripts/quiz-lint.mjs difficulty",
    "quiz:section-coverage": "node scripts/quiz-utils.mjs section-coverage",
    "quiz:overlap": "node scripts/quiz-utils.mjs overlap",
    "quiz:check-ellipsis": "node scripts/quiz-utils.mjs check-ellipsis",
    "quiz:ellipsis-report": "node scripts/quiz-utils.mjs ellipsis-report",
    "quiz:check-diagram-text": "node scripts/quiz-utils.mjs check-diagram-text",
    "quiz:check-diagram-text:report": "node scripts/quiz-utils.mjs check-diagram-text --report-only",
    "quiz:fact-check": "node scripts/quiz-fact-check.mjs",
    "quiz:cross-check": "node scripts/quiz-cross-check.mjs",
    "quiz:classify-practicality": "node scripts/classify-quiz-practicality.mjs",
    "quiz:apply-practicality": "node scripts/apply-practicality-tags.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "prepare": "husky",
    "size": "size-limit",
    "size:check": "size-limit --limit",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs"
  },
  "size-limit": [
    {
      "path": "dist-web/assets/index-*.js",
      "name": "Initial JS",
      "limit": "270 kB"
    },
    {
      "path": "dist-web/assets/vendor-*.js",
      "name": "Vendor",
      "limit": "150 kB"
    }
  ],
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@google-analytics/admin": "^9.2.0",
    "@google-analytics/data": "^6.1.0",
    "@lhci/cli": "^0.15.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-app": "^12.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^42.11.8",
    "electron-builder": "^26.15.3",
    "google-auth-library": "^10.9.1",
    "husky": "^9.1.7",
    "jscpd": "^4.3.0",
    "jsdom": "^29.1.1",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "sharp": "^0.34.5",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.3.3",
    "type-coverage": "^2.30.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.claude-code-quiz.desktop",
    "productName": "Claude Code Quiz",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*",
      "scripts/*.mjs",
      "src/data/quizzes.json",
      ".claude/skills/**/*"
    ],
    "asarUnpack": [
      "scripts/*.mjs",
      "src/data/quizzes.json",
      ".claude/skills/**/*"
    ],
    "icon": "build/icon.png",
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": "biome check --write --no-errors-on-unmatched"
  },
  "overrides": {
    "protobufjs": "^7.5.5",
    "tar": "^7.5.7",
    "@xmldom/xmldom": "^0.8.12",
    "@hono/node-server": "^1.19.13"
  },
  "type": "module"
}